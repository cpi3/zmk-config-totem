/*
 * config/totem.overlay
 *
 * Shared (unsuffixed) user overlay -> ZMK applies this automatically to
 * ALL THREE shield builds (totem_dongle, totem_left, totem_right), exactly
 * like the shared config/totem.keymap already does.
 *
 * WHY THIS FILE EXISTS
 * ---------------------
 * The "totem" shield comes from the ghyatzo/zmk-totem-module (see
 * config/west.yml). That module's totem.dtsi already defines a physical
 * layout with Studio-required `keys` (x/y/rotation) attributes, so
 * ZMK Studio was NOT missing key positions -- it already had *some*.
 *
 * What it had, though, was ghyatzo's own key geometry. You asked for the
 * geometry from cvaldezcomputerer/zmk-config's totem-layouts.dtsi instead.
 * This file adds a SECOND physical layout using that geometry, and makes
 * it the default -- without touching the module's kscan, matrix transform,
 * or your keymap bindings, all of which stay exactly as they are.
 *
 * IMPORTANT DETAIL: cvaldez's totem-layouts.dtsi lists its 38 keys in a
 * different order than ghyatzo's totem.dtsi matrix transform does (the two
 * "extra" pinky keys -- matrix positions RC(3,0) and RC(3,9) -- sit in
 * different spots in the two files' own orderings). The `keys` array below
 * is NOT a copy-paste of cvaldez's file: each entry has been re-ordered by
 * matrix position (RC(row,col)) so it lines up 1:1 with *this* build's
 * transform/keymap. Copying cvaldez's array as-is would have silently
 * shown the thumb keys and the two outer pinky keys in the wrong spots in
 * Studio's picture of the board.
 *
 * The module's original "default_layout" is untouched and still compiles
 * in as a second, selectable layout in Studio's physical layout picker --
 * it's simply no longer the default. There's no position map between the
 * two (their key widths differ slightly, 100 vs 105), so if you ever
 * switch to it inside Studio, a few key assignments may not carry over
 * automatically. You shouldn't need to; this file makes the cvaldez
 * geometry the one that's active out of the box.
 */

#include <physical_layouts.dtsi>

/ {
    cvaldez_layout: cvaldez_layout {
        compatible = "zmk,physical-layout";
        display-name = "TOTEM";
        transform = <&default_transform>; // unchanged, defined in the ghyatzo module's totem.dtsi
        kscan     = <&kscan0>;             // unchanged, defined in the ghyatzo module's totem.dtsi

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    70   136 (-1000)   120   186>
            , <&key_physical_attrs 100 100   176    54 (-400)   226   104>
            , <&key_physical_attrs 100 100   284     0      0     0     0>
            , <&key_physical_attrs 100 100   379    44      0     0     0>
            , <&key_physical_attrs 100 100   474    59      0     0     0>
            , <&key_physical_attrs 100 100   873    59      0     0     0>
            , <&key_physical_attrs 100 100   968    44      0     0     0>
            , <&key_physical_attrs 100 100  1062     0      0     0     0>
            , <&key_physical_attrs 100 100  1171    54    400  1221   104>
            , <&key_physical_attrs 100 100  1277   136   1000  1327   186>
            , <&key_physical_attrs 100 100    85   224 (-1000)   135   274>
            , <&key_physical_attrs 100 100   182   143 (-400)   232   193>
            , <&key_physical_attrs 100 100   284    90      0     0     0>
            , <&key_physical_attrs 100 100   379   134      0     0     0>
            , <&key_physical_attrs 100 100   474   148      0     0     0>
            , <&key_physical_attrs 100 100   873   148      0     0     0>
            , <&key_physical_attrs 100 100   968   134      0     0     0>
            , <&key_physical_attrs 100 100  1062    90      0     0     0>
            , <&key_physical_attrs 100 100  1165   143    400  1215   193>
            , <&key_physical_attrs 100 100  1261   224   1000  1311   274>
            , <&key_physical_attrs 100 100     0   289 (-1000)    50   339>
            , <&key_physical_attrs 100 100   101   312 (-1000)   151   362>
            , <&key_physical_attrs 100 100   188   233 (-400)   238   283>
            , <&key_physical_attrs 100 100   284   179      0     0     0>
            , <&key_physical_attrs 100 100   379   223      0     0     0>
            , <&key_physical_attrs 100 100   474   238      0     0     0>
            , <&key_physical_attrs 100 100   873   238      0     0     0>
            , <&key_physical_attrs 100 100   968   223      0     0     0>
            , <&key_physical_attrs 100 100  1062   179      0     0     0>
            , <&key_physical_attrs 100 100  1158   233    400  1208   283>
            , <&key_physical_attrs 100 100  1246   312   1000  1296   362>
            , <&key_physical_attrs 100 100  1346   289   1000  1396   339>
            , <&key_physical_attrs 100 100   352   332      0     0     0>
            , <&key_physical_attrs 100 100   457   347   1500   507   397>
            , <&key_physical_attrs 100 100   554   387   3000   604   437>
            , <&key_physical_attrs 100 100   792   387 (-3000)   842   437>
            , <&key_physical_attrs 100 100   889   347 (-1500)   939   397>
            , <&key_physical_attrs 100 100   994   332      0     0     0>
            ;
    };

    chosen {
        zmk,physical-layout = &cvaldez_layout;
    };
};

